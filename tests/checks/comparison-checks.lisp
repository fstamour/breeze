(in-package #:breeze.test.lint)

(define-test+run "error-eq-with-literal-number"
  (is equal '((0 8 :error "Don't use `eq' with literal numbers, it is not portable. Use `eql' instead."))
      (test-lint "(eq x 1)")
      "warns when the second argument is a literal number")
  (is equal '((0 8 :error "Don't use `eq' with literal numbers, it is not portable. Use `eql' instead."))
      (test-lint "(eq 1 x)")
      "warns when the first argument is a literal number")
  (is equal '((0 8 :error "Don't use `eq' with literal numbers, it is not portable. Use `eql' instead."))
      (test-lint "(eq 1 2)")
      "warns when both arguments are literal numbers")
  (is equal '((0 10 :error "Don't use `eq' with literal numbers, it is not portable. Use `eql' instead."))
      (test-lint "(eq x 1.5)")
      "warns for floats")
  (is equal '((0 9 :error "Don't use `eq' with literal numbers, it is not portable. Use `eql' instead."))
      (test-lint "(eq x -1)")
      "warns for negative numbers")
  (false (test-lint "(eq x y)")
         "no warning when neither argument is a literal number")
  (false (test-lint "(eq x nil)")
         "no warning for nil")
  (false (test-lint "'(eq x 1)")
         "no warning inside a quoted form")
  (false (test-lint "`(eq x 1)")
         "no warning inside a backquoted form")
  (false (test-lint "`(eq ,x 1)")
         "no warning when only an argument is unquoted")
  (is equal '((8 16 :error "Don't use `eq' with literal numbers, it is not portable. Use `eql' instead."))
      (test-lint "`(list ,(eq x 1))")
      "warns inside an unquoted form within a quasiquote")
  (false (test-lint "(eql x 1)")
         "no warning for `eql' only `eq'")
  (false (test-lint "(eq 1)")
         "no warning for wrong arity (one argument)")
  #++ ;; TODO this is broken at the moment
  (false (test-lint "(eq 1 2 3)")
         "no warning for wrong arity (three arguments)")
  (is equal '("eql")
      (mapcar #'replacement (fix-buffer (make-buffer :string "(eq x 1)")))
      "diagnostic carries autofix replacement \"eql\""))
